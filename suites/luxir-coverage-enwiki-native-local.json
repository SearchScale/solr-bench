{
  "pre-download": [
    "https://huggingface.co/buckets/searchscale/solr-bench/resolve/enwiki-25m.json.gz"
  ],
  "task-types": {
    "indexing": {
      "index-benchmark": {
        "name": "ENWIKI",
        "description": "Wikipedia: the first 25M 1 KB chunks of enwiki-20120502-lines-1k (lucene-bench's wikimedium10m has the first 10M)",
        "replication-type": "cloud",
        "dataset-file": "datasets/enwiki-25m.json.gz",
        "file-format": "json",
        "batch-size": 5000,
        "id-field": "id",
        "threads": [
          16
        ],
        "setups": [
          {
            "setup-name": "cloud_3x1",
            "collection": "enwiki",
            "configset": "conf_enwiki_luxir_native",
            "replication-factor": 1,
            "shards": 3
          }
        ]
      }
    },
    "restart-solr-node": {
      "restart-solr-node": "${NODE_INDEX}",
      "await-recoveries": true
    },
    "querying-BoostedOr": {
      "query-benchmark": {
        "name": "BoostedOr queries",
        "description": "coverage: BoostedOr",
        "collection": "enwiki",
        "query-file": "queries/coverage/enwiki/BoostedOr.json",
        "threads": [
          16
        ],
        "json-query": true,
        "shuffle": false,
        "total-count": 1530,
        "warm-count": 30
      }
    },
    "querying-NestedBoolean": {
