  "global-variables": {
    "collection-counter": 0,
    "restart-counter": 0
  },
  "global-constants": {
    "HOST": "localhost",
    "PORT": "8983"
  },
  "execution-plan": {
    "task1": {
      "type": "indexing",
      "description": "Indexing enwiki",
      "instances": 1,
      "concurrency": 1,
      "mode": "sync"
    },
    "task2": {
      "description": "Restart Solr node",
      "instances": 3,
      "concurrency": 1,
      "type": "restart-solr-node",
      "parameters": {
        "NODE_INDEX": "${restart-counter}"
      },
      "wait-for": "task1",
      "mode": "sync",
      "pre-task-evals": [
        "inc(restart-counter,1)"
      ]
    },
    "task3": {
      "description": "BoostedOr queries",
      "type": "querying-BoostedOr",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task2",
      "mode": "sync"
    },
    "task4": {
      "description": "NestedBoolean queries",
      "type": "querying-NestedBoolean",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task3",
      "mode": "sync"
    },
    "task5": {
      "description": "DisMaxTwoFields queries",
      "type": "querying-DisMaxTwoFields",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task4",
      "mode": "sync"
    },
    "task6": {
      "description": "Regexp queries",
      "type": "querying-Regexp",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task5",
      "mode": "sync"
    },
    "task7": {
      "description": "UnorderedSpanNear queries",
      "type": "querying-UnorderedSpanNear",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task6",
      "mode": "sync"
    },
    "task8": {
      "description": "LongRange queries",
      "type": "querying-LongRange",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task7",
      "mode": "sync"
    },
    "task9": {
      "description": "FieldExistsFilter queries",
      "type": "querying-FieldExistsFilter",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task8",
      "mode": "sync"
    },
    "task10": {
      "description": "Frange queries",
      "type": "querying-Frange",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task9",
      "mode": "sync"
    },
    "task11": {
      "description": "NegativeFilter queries",
      "type": "querying-NegativeFilter",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task10",
      "mode": "sync"
    },
    "task12": {
      "description": "SortLongFiltered queries",
      "type": "querying-SortLongFiltered",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task11",
      "mode": "sync"
    },
    "task13": {
      "description": "MultiKeySort queries",
      "type": "querying-MultiKeySort",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task12",
      "mode": "sync"
    },
    "task14": {
      "description": "DeepPaging queries",
      "type": "querying-DeepPaging",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task13",
      "mode": "sync"
    },
    "task15": {
      "description": "LegacyFacetField queries",
      "type": "querying-LegacyFacetField",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task14",
      "mode": "sync"
    },
    "task16": {
      "description": "LegacyFacetRange queries",
      "type": "querying-LegacyFacetRange",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task15",
      "mode": "sync"
    },
    "task17": {
      "description": "JsonQueryNestedFacets queries",
      "type": "querying-JsonQueryNestedFacets",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task16",
      "mode": "sync"
    },
    "task18": {
      "description": "FacetAggregations queries",
      "type": "querying-FacetAggregations",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task17",
      "mode": "sync"
    },
    "task19": {
      "description": "Grouping queries",
      "type": "querying-Grouping",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task18",
      "mode": "sync"
    }
  },
  "cluster": {
    "num-solr-nodes": 3,
    "startup-params": "-m 16g -Dsolr.searchThreads=4",
    "environment": {
      "SOLR_MODULES": "luxir-codec",
      "OMP_NUM_THREADS": "1",
      "SOLR_SECURITY_MANAGER_ENABLED": "false",
      "SOLR_OPTS": "--enable-native-access=ALL-UNNAMED -Dluxir.lucene.library=/data2/mitali-backup/solr-luxir/luxir/build/lux4j-release/bin/libluxir_lucene.so"
    },
    "provisioning-method": "local"
  },
  "repositories": [
    {
      "commit-id": "31ae830a4e8cef8968769d4a9e3281562668b6c1",
      "description": "Solr luxir-codec branch (Luxir codec module)",
      "name": "solr-luxir-repository",
      "package-subdir": "solr/packaging/",
      "build-command": "git clean -fdx && cd solr && ../gradlew -Pluxir.lucene.jar=/data2/mitali-backup/solr-luxir/luxir-lucene/build/libs/luxir-lucene-0.1.0-SNAPSHOT.jar distTar",
      "submodules": false,
      "url": "https://github.com/SearchScale/solr",
      "user": "ishan"
    }
  ],
  "metrics": [
    "jvm/solr.jvm/memory.heap.usage",
    "jvm/solr.jvm/threads.count"
  ],
  "zk-metrics": [
    "sum_configs_read_per_namespace",
    "sum_configs_write_per_namespace"
  ]
}