{
  "task-types": {
    "indexing": {
      "index-benchmark": {
        "name": "TYPES",
        "description": "types: 2.3M places with a field of every type and shape",
        "replication-type": "cloud",
        "dataset-file": "datasets/types.json.gz",
        "file-format": "json",
        "batch-size": 10000,
        "id-field": "id",
        "threads": [
          16
        ],
        "setups": [
          {
            "setup-name": "cloud_3x1",
            "collection": "types",
            "configset": "conf_types",
            "replication-factor": 1,
            "shards": 3
          }
        ]
      }
    },
    "restart-solr-node": {
      "restart-solr-node": "${NODE_INDEX}",
      "await-recoveries": true
    },
