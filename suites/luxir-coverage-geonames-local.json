{
  "pre-download": [
    "https://huggingface.co/buckets/searchscale/solr-bench/resolve/geonames.json.gz"
  ],
  "task-types": {
    "indexing": {
      "index-benchmark": {
        "name": "GEONAMES",
        "description": "Geonames: 11.4M places (text, string, numeric and location fields)",
        "replication-type": "cloud",
        "dataset-file": "datasets/geonames.json.gz",
        "file-format": "json",
        "batch-size": 10000,
        "id-field": "id",
        "threads": [
          16
        ],
        "setups": [
          {
            "setup-name": "cloud_3x1",
            "collection": "geonames",
            "configset": "conf_geonames_luxir",
            "replication-factor": 1,
            "shards": 3
          }
        ]
      }
    },
    "restart-solr-node": {
      "restart-solr-node": "${NODE_INDEX}",
      "await-recoveries": true
    },
    "querying-LegacyFacetPivot": {
      "query-benchmark": {
        "name": "LegacyFacetPivot queries",
        "description": "coverage: LegacyFacetPivot",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/LegacyFacetPivot.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-LegacyFacetFields": {
      "query-benchmark": {
        "name": "LegacyFacetFields queries",
        "description": "coverage: LegacyFacetFields",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/LegacyFacetFields.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-NumBucketsPrefix": {
      "query-benchmark": {
        "name": "NumBucketsPrefix queries",
        "description": "coverage: NumBucketsPrefix",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/NumBucketsPrefix.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-PopulationRangeFacet": {
      "query-benchmark": {
        "name": "PopulationRangeFacet queries",
        "description": "coverage: PopulationRangeFacet",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/PopulationRangeFacet.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-SortElevation": {
      "query-benchmark": {
        "name": "SortElevation queries",
        "description": "coverage: SortElevation",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/SortElevation.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-MultiKeySort": {
      "query-benchmark": {
        "name": "MultiKeySort queries",
        "description": "coverage: MultiKeySort",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/MultiKeySort.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-CursorMarkFirstPage": {
      "query-benchmark": {
        "name": "CursorMarkFirstPage queries",
        "description": "coverage: CursorMarkFirstPage",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/CursorMarkFirstPage.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-DeepPaging": {
      "query-benchmark": {
        "name": "DeepPaging queries",
        "description": "coverage: DeepPaging",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/DeepPaging.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-Grouping": {
      "query-benchmark": {
        "name": "Grouping queries",
        "description": "coverage: Grouping",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/Grouping.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-Collapse": {
      "query-benchmark": {
        "name": "Collapse queries",
        "description": "coverage: Collapse",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/Collapse.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    }
  },
  "global-variables": {
    "collection-counter": 0,
    "restart-counter": 0
  },
  "global-constants": {
    "HOST": "localhost",
    "PORT": "8983"
  },
  "execution-plan": {
    "task1": {
      "type": "indexing",
      "description": "Indexing geonames",
      "instances": 1,
      "concurrency": 1,
      "mode": "sync"
    },
    "task2": {
      "description": "Restart Solr node",
      "instances": 3,
      "concurrency": 1,
      "type": "restart-solr-node",
      "parameters": {
        "NODE_INDEX": "${restart-counter}"
      },
      "wait-for": "task1",
      "mode": "sync",
      "pre-task-evals": [
        "inc(restart-counter,1)"
      ]
    },
    "task3": {
      "description": "LegacyFacetPivot queries",
      "type": "querying-LegacyFacetPivot",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task2",
      "mode": "sync"
    },
    "task4": {
      "description": "LegacyFacetFields queries",
      "type": "querying-LegacyFacetFields",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task3",
      "mode": "sync"
    },
    "task5": {
      "description": "NumBucketsPrefix queries",
      "type": "querying-NumBucketsPrefix",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task4",
      "mode": "sync"
    },
    "task6": {
      "description": "PopulationRangeFacet queries",
      "type": "querying-PopulationRangeFacet",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task5",
      "mode": "sync"
    },
    "task7": {
      "description": "SortElevation queries",
      "type": "querying-SortElevation",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task6",
      "mode": "sync"
    },
    "task8": {
      "description": "MultiKeySort queries",
      "type": "querying-MultiKeySort",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task7",
      "mode": "sync"
    },
    "task9": {
      "description": "CursorMarkFirstPage queries",
      "type": "querying-CursorMarkFirstPage",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task8",
      "mode": "sync"
    },
    "task10": {
      "description": "DeepPaging queries",
      "type": "querying-DeepPaging",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task9",
      "mode": "sync"
    },
    "task11": {
      "description": "Grouping queries",
      "type": "querying-Grouping",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task10",
      "mode": "sync"
    },
    "task12": {
      "description": "Collapse queries",
      "type": "querying-Collapse",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task11",
      "mode": "sync"
    }
  },
  "cluster": {
    "num-solr-nodes": 3,
    "startup-params": "-m 16g -Dsolr.searchThreads=4",
    "environment": {
      "SOLR_MODULES": "luxir-codec",
      "OMP_NUM_THREADS": "1",
      "SOLR_SECURITY_MANAGER_ENABLED": "false",
      "SOLR_OPTS": "--enable-native-access=ALL-UNNAMED -Dluxir.lucene.library=/data2/mitali-backup/solr-luxir/luxir/build/lux4j-release/bin/libluxir_lucene.so"
    },
    "provisioning-method": "local"
  },
  "repositories": [
    {
      "commit-id": "35d1e2b3871017184e90db8349c67801f898c519",
      "description": "Solr luxir-codec branch (Luxir codec module)",
      "name": "solr-luxir-repository",
      "package-subdir": "solr/packaging/",
      "build-command": "git clean -fdx && cd solr && ../gradlew -Pluxir.lucene.jar=/data2/mitali-backup/solr-luxir/luxir-lucene/build/libs/luxir-lucene-0.1.0-SNAPSHOT.jar distTar",
      "submodules": false,
      "url": "https://github.com/SearchScale/solr",
      "user": "ishan"
    }
  ],
  "metrics": [
    "jvm/solr.jvm/memory.heap.usage",
    "jvm/solr.jvm/threads.count"
  ],
  "zk-metrics": [
    "sum_configs_read_per_namespace",
    "sum_configs_write_per_namespace"
  ]
}