  "global-variables": {
    "collection-counter": 0,
    "restart-counter": 0
  },
  "global-constants": {
    "HOST": "localhost",
    "PORT": "8983"
  },
  "execution-plan": {
    "task1": {
      "type": "indexing",
      "description": "Indexing geonames",
      "instances": 1,
      "concurrency": 1,
      "mode": "sync"
    },
    "task2": {
      "description": "Restart Solr node",
      "instances": 3,
      "concurrency": 1,
      "type": "restart-solr-node",
      "parameters": {
        "NODE_INDEX": "${restart-counter}"
      },
      "wait-for": "task1",
      "mode": "sync",
      "pre-task-evals": [
        "inc(restart-counter,1)"
      ]
    },
    "task3": {
      "description": "LegacyFacetPivot queries",
      "type": "querying-LegacyFacetPivot",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task2",
      "mode": "sync"
    },
    "task4": {
      "description": "LegacyFacetFields queries",
      "type": "querying-LegacyFacetFields",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task3",
      "mode": "sync"
    },
    "task5": {
      "description": "NumBucketsPrefix queries",
      "type": "querying-NumBucketsPrefix",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task4",
      "mode": "sync"
    },
    "task6": {
      "description": "PopulationRangeFacet queries",
      "type": "querying-PopulationRangeFacet",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task5",
      "mode": "sync"
    },
    "task7": {
      "description": "SortElevation queries",
      "type": "querying-SortElevation",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task6",
      "mode": "sync"
    },
    "task8": {
      "description": "MultiKeySort queries",
      "type": "querying-MultiKeySort",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task7",
      "mode": "sync"
    },
    "task9": {
      "description": "CursorMarkFirstPage queries",
      "type": "querying-CursorMarkFirstPage",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task8",
      "mode": "sync"
    },
    "task10": {
      "description": "DeepPaging queries",
      "type": "querying-DeepPaging",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task9",
      "mode": "sync"
    },
    "task11": {
      "description": "Grouping queries",
      "type": "querying-Grouping",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task10",
      "mode": "sync"
    },
    "task12": {
      "description": "Collapse queries",
      "type": "querying-Collapse",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task11",
      "mode": "sync"
    },
    "task13": {
      "description": "Highlight queries",
      "type": "querying-Highlight",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task12",
      "mode": "sync"
    },
    "task14": {
      "description": "EdismaxNames queries",
      "type": "querying-EdismaxNames",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task13",
      "mode": "sync"
    },
    "task15": {
      "description": "Geofilt queries",
      "type": "querying-Geofilt",
      "instances": 1,
      "concurrency": 1,
      "wait-for": "task14",
      "mode": "sync"
    },
    "task16": {
      "description": "MoreLikeThis queries",
      "type": "querying-MoreLikeThis",
      "instances": 1,
      "concurrency": 1,
