{
  "pre-download": [
    "https://huggingface.co/buckets/searchscale/solr-bench/resolve/geonames.json.gz"
  ],
  "task-types": {
    "indexing": {
      "index-benchmark": {
        "name": "GEONAMES",
        "description": "Geonames: 11.4M places (text, string, numeric and location fields)",
        "replication-type": "cloud",
        "dataset-file": "datasets/geonames.json.gz",
        "file-format": "json",
        "batch-size": 10000,
        "id-field": "id",
        "threads": [
          16
        ],
        "setups": [
          {
            "setup-name": "cloud_3x1",
            "collection": "geonames",
            "configset": "conf_geonames",
            "replication-factor": 1,
            "shards": 3
          }
        ]
      }
    },
    "restart-solr-node": {
      "restart-solr-node": "${NODE_INDEX}",
      "await-recoveries": true
    },
    "querying-LegacyFacetPivot": {
      "query-benchmark": {
        "name": "LegacyFacetPivot queries",
        "description": "coverage: LegacyFacetPivot",
        "collection": "geonames",
        "query-file": "queries/coverage/geonames/LegacyFacetPivot.txt",
        "http-method": "POST",
        "threads": [
          16
        ],
        "shuffle": false,
        "duration-secs": 10,
        "warm-count": 16
      }
    },
    "querying-LegacyFacetFields": {
      "query-benchmark": {
