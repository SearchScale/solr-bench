                "replication-type": "cloud",
                "dataset-file": "datasets/enwiki-10m.json.gz",
                "file-format": "json",
                "batch-size": 5000,
                "id-field": "id",
                "threads": [
                    16
                ],
                "setups": [
                    {
                        "setup-name": "cloud_3x1",
                        "collection": "enwiki",
                        "configset": "conf_enwiki",
                        "replication-factor": 1,
                        "shards": 3
                    }
                ]
            }
        },
